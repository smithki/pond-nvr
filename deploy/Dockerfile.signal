# pond-signal: Pond's signaling service (a blind courier for sealed envelopes, and STUN), built from this repository.
FROM swift:6.2-noble AS build
WORKDIR /work
COPY protocol /work/protocol
COPY signaling /work/signaling
RUN swift build -c release --package-path signaling --product pond-signal \
 && cp "$(swift build -c release --package-path signaling --show-bin-path)/pond-signal" /pond-signal

FROM swift:6.2-noble-slim
COPY --from=build /pond-signal /usr/local/bin/pond-signal
USER nobody
EXPOSE 8080/tcp 3478/udp 3479/udp
ENTRYPOINT ["pond-signal", "--port", "8080", "--stun", "3478", "--stun-alternate", "3479"]
