<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Pond NVR.app's entitlements, under the hardened runtime (which notarization requires): the microphone, for
     talking through a camera's speaker (LiveControlsModel). Nothing else is asked for: no JIT, no unsigned code, no
     libraries from elsewhere. pond itself (the recorder) needs none. -->
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
